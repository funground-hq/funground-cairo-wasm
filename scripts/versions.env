# Pinned versions for the S-134 build. Every script sources this file.
PYODIDE_VERSION=314.0.7
PYODIDE_ABI=2026_0            # wheel tag: pyemscripten_2026_0_wasm32
PYTHON_VERSION=3.14           # Pyodide 314.0.7 ships CPython 3.14.2; host Python must match major.minor
EMSCRIPTEN_VERSION=5.0.3      # from the xbuildenv's Makefile.envs (PYODIDE_EMSCRIPTEN_VERSION)
PYODIDE_BUILD_VERSION=0.39.1

CAIRO_VERSION=1.18.4          # goldens were made with pycairo 1.29.2's Windows wheel, which bundles cairo 1.18.6
PIXMAN_VERSION=0.46.4
LIBPNG_VERSION=1.6.59
ZLIB_VERSION=1.3.1
PYCAIRO_VERSION=1.29.2

# Upstream tarballs as mirrored by the Ubuntu archive (cairographics.org and
# gitlab.freedesktop.org were not reachable from the build sandbox). Hashes in sources.sha256.
UBUNTU_POOL=https://archive.ubuntu.com/ubuntu/pool/main
CAIRO_URL=$UBUNTU_POOL/c/cairo/cairo_${CAIRO_VERSION}.orig.tar.xz
PIXMAN_URL=$UBUNTU_POOL/p/pixman/pixman_${PIXMAN_VERSION}.orig.tar.gz
LIBPNG_URL=$UBUNTU_POOL/libp/libpng1.6/libpng1.6_${LIBPNG_VERSION}.orig.tar.gz
ZLIB_URL="$UBUNTU_POOL/z/zlib/zlib_1.3.dfsg+really${ZLIB_VERSION}.orig.tar.gz"
PYODIDE_RELEASES=https://github.com/pyodide/pyodide/releases/download/$PYODIDE_VERSION
XBUILDENV_URL=$PYODIDE_RELEASES/xbuildenv-$PYODIDE_VERSION.tar.bz2
PYODIDE_DIST_URL=$PYODIDE_RELEASES/pyodide-$PYODIDE_VERSION.tar.bz2
PYCAIRO_URL=https://files.pythonhosted.org/packages/source/p/pycairo/pycairo-${PYCAIRO_VERSION}.tar.gz   # redirects to the hashed sdist URL
SKIA_PATHOPS_VERSION=0.9.2
SKIA_PATHOPS_URL=https://files.pythonhosted.org/packages/source/s/skia-pathops/skia_pathops-${SKIA_PATHOPS_VERSION}.tar.gz
